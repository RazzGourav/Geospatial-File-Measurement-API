# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./geospatial.db

# Upload limits
MAX_UPLOAD_BYTES=52428800
MAX_ARCHIVE_EXPANSION_BYTES=262144000
MAX_FEATURE_COUNT=10000

# Pagination
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=500

# File storage
UPLOAD_DIR=./uploads
TEMP_DIR=./tmp

# Security
API_KEY=change-me-in-production
REQUIRE_AUTH=false
